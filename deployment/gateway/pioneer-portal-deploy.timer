[Unit]
Description=Poll for new Pioneer Portal release tags and deploy them
Documentation=file:/root/pioneer-portal/deployment/gateway/README.md

[Timer]
# Every 5 minutes. RandomizedDelaySec spreads the poll so we never hammer
# GitHub at a fixed second; Persistent means a tick missed while the host was
# down is executed once on the next boot.
OnBootSec=3min
OnUnitActiveSec=5min
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
