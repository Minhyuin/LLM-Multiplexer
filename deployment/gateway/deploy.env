# ---------------------------------------------------------------------------
# Pioneer Portal deploy gateway - configuration
#   read by /root/pioneer-portal.deploy/gateway/deploy.sh (and by hand)
#   NOT a systemd EnvironmentFile for the portal itself; the portal keeps .env
# ---------------------------------------------------------------------------

# Which repository to deploy FROM. Only tags reachable from this remote are
# ever deployed. Point this at the fork; change it if the fork moves.
DEPLOY_REPO_URL="https://github.com/Minhyuin/LLM-Multiplexer.git"

# Tag pattern. Only tags matching this glob are candidates, so scratch tags
# (test, tmp, wip) can never trigger a deploy.
DEPLOY_TAG_PATTERN="v*"

# What to build after a new tag appears.
DEPLOY_BRANCH="main"

# --- paths -----------------------------------------------------------------
APP_LINK="/root/pioneer-portal"                 # stable symlink (one value, never moves)
RELEASES_DIR="/root/pioneer-portal.releases"    # one directory per deployed tag
# Shared state lifted out of the code tree: .env, .venv, media, staticfiles.
# A release only ever symlinks to these; no deploy or prune can destroy them.
SHARED_DIR="/root/pioneer-portal.shared"
STATE_DIR="/root/pioneer-portal.deploy/state"
LOG_DIR="/var/log/pioneer-portal"
TORCH_DIR="/root/pioneer-portal.deploy/torch"   # staging + wheelhouse
LOG_FILE="/var/log/pioneer-portal/deploy.log"

VENV="/root/pioneer-portal/.venv"               # reached through the symlink
ENV_FILE="/root/pioneer-portal/.env"            # read at migrate time only
SERVICE="pioneer-portal"

# --- behaviour -------------------------------------------------------------
# Health checks as "url:expected_status" pairs; every pair must match after the
# symlink flips or the deploy is rolled back automatically. Plain
# "http://..." means 200.
#
# These deliberately talk to gunicorn directly. Note that on this host the
# DEFAULT nginx server block (root /var/www/html) also listens on :80, and
# nginx picks a block by Host header - so a request to http://127.0.0.1/ is
# answered by the default block and 404s on every portal path. Verifying nginx
# routing is a separate concern from verifying that the portal itself came up,
# so the check stays on 127.0.0.1:8002, where no Host header is needed.
#
# /dashboard/public/ legitimately redirects to the login page for an anonymous
# caller, so 302 is the correct expected status there, not a failure.
HEALTH_CHECKS="http://127.0.0.1:8002/health/:200 http://127.0.0.1:8002/:200 http://127.0.0.1:8002/dashboard/public/:302"
HEALTH_RETRIES=20
HEALTH_DELAY=3
# Sent as the Host header on every health request. Empty = let curl use the
# URL's own host, which is what 127.0.0.1:8002 wants.
HEALTH_HOST=""
# Optional end-to-end check through nginx, run after the checks above pass.
# Off by default: it only works when the request carries a Host header that
# actually matches the portal's server_name, and nginx is outside this
# gateway's scope. Set to e.g. "http://154.201.92.23/health/:200" to use it.
EXTRA_HEALTH_CHECK=""

# Releases kept on disk (the live one included). Older ones are pruned after a
# successful deploy; the current and previous are always kept.
KEEP_RELEASES=5

# 1 = run django migrate when the new release has pending migrations.
#     A pg_dump is taken first unless SKIP_DB_BACKUP=1.
# 0 = refuse to deploy a tag that needs migrations, and report instead.
ALLOW_AUTO_MIGRATE=1
SKIP_DB_BACKUP=0

# 1 = only download and inspect, print what would happen, change nothing.
DRY_RUN=0

# git/network tuning: the gateway must never hang on a bad network.
GIT_TIMEOUT=300
