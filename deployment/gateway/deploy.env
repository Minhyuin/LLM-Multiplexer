# ---------------------------------------------------------------------------
# Pioneer Portal deploy gateway - configuration
#   read by /root/pioneer-portal/deployment/gateway/deploy.sh (and by hand)
#   NOT a systemd EnvironmentFile for the portal itself; the portal keeps .env
# ---------------------------------------------------------------------------

# Which repository to deploy FROM. Only tags reachable from this remote are
# ever deployed. Point this at the fork; change it if the fork moves.
DEPLOY_REPO_URL="https://github.com/Minhyuin/LLM-Multiplexer.git"

# Tag pattern. Only tags matching this glob are candidates, so scratch tags
# (test, tmp, wip) can never trigger a deploy.
DEPLOY_TAG_PATTERN="v*"

# What to build after a new tag appears.
DEPLOY_BRANCH="main"

# --- paths -----------------------------------------------------------------
APP_LINK="/root/pioneer-portal"                 # stable symlink (one value, never moves)
RELEASES_DIR="/root/pioneer-portal.releases"    # one directory per deployed tag
STATE_DIR="/root/pioneer-portal.deploy/state"
LOG_DIR="/var/log/pioneer-portal"
TORCH_DIR="/root/pioneer-portal.deploy/torch"   # staging + wheelhouse
LOG_FILE="/var/log/pioneer-portal/deploy.log"

VENV="/root/pioneer-portal/.venv"               # reached through the symlink
ENV_FILE="/root/pioneer-portal/.env"            # read at migrate time only
SERVICE="pioneer-portal"

# --- behaviour -------------------------------------------------------------
# Health checks that must all pass after the symlink flips. Any failure flips
# the symlink back to the previous release automatically.
HEALTH_URLS="http://127.0.0.1:8002/health/ http://127.0.0.1:8002/ http://127.0.0.1/dashboard/public/"
HEALTH_RETRIES=20
HEALTH_DELAY=3

# Releases kept on disk (the live one included). Older ones are pruned after a
# successful deploy; the current and previous are always kept.
KEEP_RELEASES=5

# 1 = run django migrate when the new release has pending migrations.
#     A pg_dump is taken first unless SKIP_DB_BACKUP=1.
# 0 = refuse to deploy a tag that needs migrations, and report instead.
ALLOW_AUTO_MIGRATE=1
SKIP_DB_BACKUP=0

# 1 = only download and inspect, print what would happen, change nothing.
DRY_RUN=0

# git/network tuning: the gateway must never hang on a bad network.
GIT_TIMEOUT=300
