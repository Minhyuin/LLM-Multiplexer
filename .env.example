DJANGO_SECRET_KEY=replace-me-with-a-secure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

POSTGRES_DB=lab_portal
POSTGRES_USER=lab_portal
POSTGRES_PASSWORD=lab_portal_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

TIME_ZONE=Asia/Shanghai
LANGUAGE_CODE=zh-hans

# Private announcement/discussion attachments: serve through Django, never nginx aliases.
# Docker default: /app/private_uploads (named volume).
# Symlink releases: set an absolute shared path, e.g. /root/pioneer-portal.shared/private_uploads.
# PRIVATE_UPLOAD_ROOT=/app/private_uploads
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_BATCH_BYTES=18874368
ATTACHMENT_MAX_PER_CONTENT=10
ATTACHMENT_MAX_PIXELS=50000000
ATTACHMENT_MAX_EDGE=20000

PUBLIC_DASHBOARD_ENABLED=True
PUBLIC_DASHBOARD_MASK_USERNAMES=True

CLIPROXY_BASE_URL=http://host.docker.internal:8317
CLIPROXY_MANAGEMENT_KEY=PIONEER103

# --- GitHub Activity Sync ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_USERNAME=your-github-username
GITHUB_WEBHOOK_SECRET=your-webhook-secret
